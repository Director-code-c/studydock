{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyDock",
  "version": "0.3.0",
  "identifier": "com.directorcodec.studydock",
  "build": {
    "beforeDevCommand": "npm run dev -- --hostname 127.0.0.1",
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://studydock-two.vercel.app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StudyDock",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
